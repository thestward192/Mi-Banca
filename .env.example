# Copia este archivo como .env y completa los valores.
# En Vercel se cargan en Project Settings > Environment Variables.

# Firebase > Configuracion del proyecto > Tus apps > App web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sufijo fijo que se agrega a la contrasena antes de enviarla a Firebase
# (Firebase pide minimo 6 caracteres). Ejemplo: "mb" -> 1234 se guarda como 1234mb.
# Si lo cambias, hay que cambiar tambien la contrasena del usuario en Firebase.
VITE_PASS_SUFFIX=
